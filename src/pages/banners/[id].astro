---
// Dev-only page that renders a project banner at 1600×480.
// `npm run banners` screenshots it into src/assets/banners/<id>.png.
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/800.css';
import '@fontsource/ibm-plex-sans/500.css';
import type { ImageMetadata } from 'astro';
import { banners } from '../../data/banners';
import { projects, stack } from '../../data/shared';

export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return Object.keys(banners).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const project = projects.find((p) => p.id === id)!;
const cfg = banners[id];

const shots = Object.entries(
  import.meta.glob<ImageMetadata>('/src/assets/screenshots/*/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' }),
)
  .filter(([path]) => path.includes(`/screenshots/${id}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, img]) => img)
  .slice(0, 3);

// Extra colors for tools that only appear on banners.
const bannerOnly = [
  { name: 'Firestore', ab: 'Fs', bg: '#FFA000', fg: '#0d1117' },
  { name: 'ESP32', ab: 'E3', bg: '#E7352C', fg: '#ffffff' },
  { name: 'Gemini AI', ab: 'Gm', bg: '#4285F4', fg: '#ffffff' },
];
const allTech = [...stack.flatMap((g) => g.items), ...bannerOnly];
const tech = (cfg.tech ?? project.stack.split('·').map((s) => s.trim()))
  .map((name) => allTech.find((t) => t.name === name) ?? { name, ab: name.slice(0, 2), bg: '#30363d', fg: '#e6edf3' });

// The first screenshot is the hero (middle, higher); the others sit lower, behind it.
const slots = ['mid', 'right', 'left'];
const frame = cfg.frame ?? 'phone';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{project.name} banner</title>
    <style define:vars={{ accent: cfg.accent }}>
      * { box-sizing: border-box; }
      html, body { margin: 0; background: #0d1117; }
      .banner {
        position: relative; width: 1600px; height: 480px; overflow: hidden;
        background:
          radial-gradient(ellipse 520px 380px at 1170px 300px, color-mix(in srgb, var(--accent) 34%, transparent), transparent 70%),
          radial-gradient(circle at 1px 1px, #1f2630 1px, transparent 0) 0 0 / 24px 24px,
          #0d1117;
        color: #e6edf3; font-family: 'IBM Plex Sans', sans-serif;
      }
      .left { position: absolute; left: 88px; top: 0; bottom: 0; width: 700px; display: flex; flex-direction: column; justify-content: center; gap: 22px; z-index: 2; }
      .path { font-family: 'JetBrains Mono', monospace; font-size: 20px; color: #3fb950; }
      h1 { margin: 0; font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 96px; line-height: 1; letter-spacing: -0.03em; }
      h1 span { color: var(--accent); }
      .tiles { display: flex; flex-wrap: wrap; gap: 10px; }
      .tile { display: inline-flex; align-items: center; gap: 12px; padding: 7px 16px 7px 7px; border: 1px solid #30363d; border-radius: 12px; background: #0d1117; font-size: 19px; font-weight: 500; }
      .badge { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 800; }
      .play { display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; padding: 8px 16px; border: 1px solid #2ea043; border-radius: 999px; color: #3fb950; font-size: 18px; font-weight: 500; }
      .phones { position: absolute; left: 800px; right: 0; top: 0; bottom: 0; }
      .phone {
        position: absolute; width: 270px; aspect-ratio: 9 / 19.5; padding: 8px;
        border-radius: 40px; background: #1c2128; border: 1px solid #3a424d;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.6);
      }
      .phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 32px; display: block; }
      .phone.mid { left: 250px; top: 72px; z-index: 2; }
      .phone.left { left: 0; top: 140px; z-index: 1; transform: rotate(-4deg); }
      .phone.right { left: 500px; top: 140px; z-index: 1; transform: rotate(4deg); }
      .phone.left img, .phone.right img { filter: brightness(0.85); }
      .window {
        position: absolute; width: 540px; border-radius: 12px; overflow: hidden;
        background: #1c2128; border: 1px solid #3a424d;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.6);
      }
      .window .bar { display: flex; gap: 7px; padding: 10px 12px; background: #161b22; border-bottom: 1px solid #30363d; }
      .window .bar i { width: 11px; height: 11px; border-radius: 50%; background: #30363d; }
      .window img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
      .window.mid { left: 40px; top: 120px; z-index: 2; }
      .window.right { left: 200px; top: 52px; z-index: 1; }
      .window.right img { filter: brightness(0.7); }
    </style>
  </head>
  <body>
    <div class="banner" id="banner">
      <div class="left">
        <span class="path">&gt; ~/projects/{project.id}</span>
        <h1>{project.name}<span>_</span></h1>
        <div class="tiles">
          {tech.map((t) => <span class="tile"><span class="badge" style={`background:${t.bg};color:${t.fg}`}>{t.ab}</span>{t.name}</span>)}
        </div>
        {cfg.badge === 'play' && (
          <span class="play">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5v17l14-8.5z" /></svg>
            Google Play
          </span>
        )}
      </div>
      <div class="phones">
        {frame === 'phone' && shots.map((img, i) => (
          <div class={`phone ${slots[i]}`}><img src={img.src} alt="" /></div>
        ))}
        {frame === 'window' && shots.slice(0, 2).map((img, i) => (
          <div class={`window ${slots[i]}`}><div class="bar"><i /><i /><i /></div><img src={img.src} alt="" /></div>
        ))}
      </div>
    </div>
  </body>
</html>
