---
import { localeLabels, localePath, type Dict, type Locale } from '../i18n';
import { locales } from '../i18n/types';

interface Props {
  t: Dict;
  locale: Locale;
}
const { t, locale } = Astro.props;
// Same order as the sections on the page; the active link follows the scroll position.
const links = [
  ['#about', t.nav.about],
  ['#work', t.nav.projects],
  ['#apps', t.nav.apps],
  ['#experience', t.nav.experience],
  ['#certifications', t.nav.certifications],
  ['#skills', t.nav.skills],
  ['#contact', t.nav.contact],
];
---

<header class="nav" id="nav">
  <div class="nav-inner">
    <a class="brand" href="#top"><span class="mono g">&gt;</span> {locale === 'ar' ? t.hero.name : 'louay barraq'}<span class="mono g">_</span></a>
    <nav class="nav-links" id="nav-links" aria-label="Main">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="nav-right">
      <div class="lang" aria-label={t.nav.language}>
        {locales.map((l, i) => (
          <>
            {i > 0 && <span class="lang-sep" aria-hidden="true">·</span>}
            <a href={localePath(l)} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined}>{localeLabels[l]}</a>
          </>
        ))}
      </div>
      <button class="menu-btn" type="button" aria-label={t.nav.menu} aria-controls="nav-links" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('nav')!;
  const btn = nav.querySelector<HTMLButtonElement>('.menu-btn')!;
  const toggle = (open: boolean) => {
    nav.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => toggle(!nav.classList.contains('open')));
  nav.querySelectorAll('.nav-links a').forEach((a) => a.addEventListener('click', () => toggle(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && toggle(false));

  // Scroll spy: the active link is the last section whose top has passed the header.
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('.nav-links a')];
  const sections = links
    .map((a) => ({ a, el: document.querySelector<HTMLElement>(a.getAttribute('href')!) }))
    .filter((x): x is { a: HTMLAnchorElement; el: HTMLElement } => !!x.el);
  const update = () => {
    const line = nav.offsetHeight + 40;
    let current: HTMLAnchorElement | null = null;
    for (const { a, el } of sections) if (el.getBoundingClientRect().top <= line) current = a;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
    if (atBottom && sections.length) current = sections[sections.length - 1].a;
    for (const a of links) {
      const on = a === current;
      a.classList.toggle('active', on);
      if (on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>
