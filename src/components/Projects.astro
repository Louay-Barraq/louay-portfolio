---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Window from './Window.astro';
import { projects } from '../data/shared';
import type { Dict, Locale } from '../i18n';

interface Props {
  t: Dict;
  locale: Locale;
}
const { t, locale } = Astro.props;

// Banners exported by `npm run banners` are picked up automatically by file name.
const bannerFiles = import.meta.glob<ImageMetadata>('../assets/banners/*.png', { eager: true, import: 'default' });
const bannerFor = (id: string) => bannerFiles[`../assets/banners/${id}.png`];
---

<section id="work" style="display:flex;flex-direction:column;gap:18px">
  <h2 class="section-title"><span class="mono g">&gt;</span> {t.projects.title} <small>{t.projects.count(projects.length)}</small></h2>
  <div class="cards">
    {projects.map((p) => {
      const name = locale === 'ar' && p.nameAr ? p.nameAr : p.name;
      const banner = bannerFor(p.id);
      return (
        <Window dots="plain" class="project">
          <div class="banner">
            {banner ? (
              <Image src={banner} alt={`${name}: app screenshots`} widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 660px" loading="lazy" />
            ) : (
              t.projects.banner(name)
            )}
          </div>
          <div class="project-body">
            <div class="project-head">
              <h3>{name}</h3>
              <span class="year">{p.year}</span>
            </div>
            <p>{t.projects.desc[p.id]}</p>
            <div class="project-foot">
              <span>{t.projects.builtWith} <bdi>{p.stack}</bdi></span>
              {p.status && <span class={`chip st st-${p.status}`}>{t.projects.status[p.status]}</span>}
            </div>
            <div class="project-links">
              <a href={p.repo}>{t.projects.code} {t.arrow}</a>
              {p.playUrl && (
                <a href={p.playUrl}>
                  <svg class="play-ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 2.5 12 12 4 21.5Z" fill="#00a0ff" />
                    <path d="M4 2.5 16.2 9.53 12 12Z" fill="#00e676" />
                    <path d="M4 21.5 12 12l4.2 2.47Z" fill="#ff3a44" />
                    <path d="M16.2 9.53 20.5 12l-4.3 2.47L12 12Z" fill="#ffd500" />
                  </svg>
                  Google Play {t.arrow}
                </a>
              )}
            </div>
          </div>
        </Window>
      );
    })}
  </div>
</section>
