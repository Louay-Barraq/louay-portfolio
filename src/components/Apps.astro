---
import Window from './Window.astro';
import { apps } from '../data/shared';
import type { Dict, Locale } from '../i18n';

interface Props {
  t: Dict;
  locale: Locale;
}
const { t, locale } = Astro.props;
---

<Window file="google-play" id="apps">
  <div class="win-body">
    <div class="section-head">
      <h2 class="h2">{t.apps.title}</h2>
      <span class="sub">{t.apps.usage}</span>
    </div>
    <div class="apps">
      {apps.map((a) => {
        const name = locale === 'ar' && a.nameAr ? a.nameAr : a.name;
        const Tag = a.url ? 'a' : 'div';
        return (
          <Tag class="app" href={a.url}>
            <span class="app-icon" aria-hidden="true">{a.icon ? <img src={a.icon} alt="" width="48" height="48" /> : a.name[0]}</span>
            <strong>{name}</strong>
            <span class="app-tag">{t.apps.tag[a.id]}</span>
            <span class={`app-status st-${a.status}`}>{t.apps.status[a.status]}</span>
          </Tag>
        );
      })}
    </div>
  </div>
</Window>
