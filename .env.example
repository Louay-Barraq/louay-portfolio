# Copy to .env for local builds, and add the same variables in Vercel → Project → Settings → Environment Variables.

# Fine-grained GitHub token (read-only, your own account) so stats include private commits.
# Without it the site uses the snapshot in src/lib/github.ts.
GITHUB_TOKEN=

# Web3Forms access key (https://web3forms.com, enter louaybarraq@gmail.com).
# Without it the contact form opens the visitor's mail app instead.
PUBLIC_WEB3FORMS_KEY=

# Final public address, used for canonical / hreflang links.
SITE_URL=
